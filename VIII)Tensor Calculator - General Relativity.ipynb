    "\n",
    "orientation = \"down\" #Orientation of the gtensor, whether it is g_mu_nu (\"down\") or g^mu^nu (\"up\")\n",
    "\n",
    "metric = [gtensor,variables,orientation] #List of the gtensor, variables and orientation to be used"
