    "## 3. Symmetries\n",
    "This additional part of the code computes the differential equations for the components of the Killing Vector. <br>\n",
    "In simpler terms, a Killing vector field corresponds to a symmetry of the spacetime such that if you \"move\" along the flow of this vector, the shape of the spacetime does not change"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 131,
   "metadata": {},
   "outputs": [],
   "source": [
    "def SolveKillingVectors(metricpack):\n",
    "    from sympy import symbols, Function, simplify, Eq, diff, dsolve\n",
    "    from sympy.core.symbol import Symbol\n",
    "\n",
    "    g, sym, orientation = metricpack\n",
    "\n",
    "    if orientation not in [\"down\", \"up\"]:\n",
    "        print(orientationError)\n",
    "        return\n",
    "\n",
    "    # Robust symbol creation\n",
    "    if isinstance(sym[0], str):\n",
    "        coords = [symbols(s) for s in sym]\n",
    "    else:\n",
    "        coords = sym\n",
    "\n",
    "    xi = [Function(f'xi{i}')(*coords) for i in range(4)]\n",
    "    Gamma = ChristoffelSymbols(metricpack)\n",
    "\n",
    "    equations = []\n",
    "\n",
    "    # Build the Killing equations: ∇_μ ξ_ν + ∇_ν ξ_μ = 0\n",
    "    for mu in range(4):\n",
    "        for nu in range(mu, 4):  # symmetric in mu, nu\n",
    "            term = diff(xi[nu], coords[mu]) + diff(xi[mu], coords[nu])\n",
    "            for lam in range(4):\n",
    "                term -= Gamma[(lam, mu)][nu]*xi[lam]\n",
    "                term -= Gamma[(lam, nu)][mu]*xi[lam]\n",
    "            eq = simplify(term)\n",
    "            equations.append(Eq(eq, 0))\n",
    "\n",
    "    print(f\"{len(equations)} Killing equations generated\")\n",
    "\n",
    "    return equations\n",
    "\n"
   ]
